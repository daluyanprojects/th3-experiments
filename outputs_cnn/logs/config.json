{
  "encoder_name": "efficientnet-b3",
  "encoder_weights": "imagenet",
  "decoder_channels": [
    256,
    128,
    64,
    32,
    16
  ],
  "use_conditioning": true,
  "rainfall_dim": 13,
  "conditioning_dim": 4,
  "context_dim": 256,
  "mlp_hidden": 128,
  "num_classes": 5,
  "spatial_channels": 3,
  "map_h": 1152,
  "map_w": 1152,
  "ignore_index": -1,
  "batch_size": 2,
  "grad_accum_steps": 8,
  "num_epochs": 20,
  "num_folds": 2,
  "lr": 0.0001,
  "weight_decay": 0.0001,
  "grad_clip_norm": 1.0,
  "warmup_epochs": 5,
  "min_lr": 1e-06,
  "loss_type": "combined",
  "ce_weight": 0.9,
  "dice_weight": 0.1,
  "focal_gamma": 2.0,
  "label_smoothing": 0.0,
  "weight_power": 0.5,
  "checkpoint_metric": "macro_f1",
  "output_dir": "outputs_cnn"
}